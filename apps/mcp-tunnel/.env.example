CONTROL_PLANE_TUNNEL_ID=tunnel_...
CONTROL_PLANE_API_KEY=sk-...
# Optional; relative paths are resolved from apps/mcp-tunnel.
TUNNEL_CLIENT_PATH=./tunnel-client.exe
MCP_WORKSPACE_ROOT=.
# Optional comma-separated additional workspace paths/globs.
MCP_WORKSPACE_ALLOWED=../shared/*,D:/Workspace/game-dev/*
# Optional shared MCP instructions file included in initialize response. Supports ~/...
MCP_INSTRUCTIONS_FILE=./instructions.md
# Optional standard MCP server manifest. Restart Tunnel after changing it.
MCP_EXTERNAL_MCP_FILE=./external-mcp.json
# Unset = core tools plus every discovered external MCP tool.
# Set = expose only the named built-in/external tools.
TOOLS_ENABLED=read,write,edit,bash,read_image,read_many,edit_many,notify
BRAIN_ENABLED=false
BRAIN_ACCESS=read
