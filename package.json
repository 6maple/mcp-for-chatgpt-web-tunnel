{
  "name": "mcp-for-chatgpt-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check",
    "stub": "turbo run stub",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "vp lint --type-aware",
    "lint:fix": "vp lint --fix --type-aware",
    "quality": "vp check",
    "ci": "vp check && vp run check && vp run build",
    "init:brain": "node scripts/init-brain.mjs",
    "setup:hooks": "vp config --no-agent",
    "postinstall": "pnpm setup:hooks && turbo run stub",
    "start:mcp-tunnel": "pnpm --filter @workspace/mcp-tunnel start:tunnel",
    "start:mcp-tunnel:pm2": "pnpm --filter @workspace/mcp-tunnel start:pm2",
    "restart:mcp-tunnel:pm2": "pnpm --filter @workspace/mcp-tunnel restart:pm2",
    "stop:mcp-tunnel:pm2": "pnpm --filter @workspace/mcp-tunnel stop:pm2",
    "build:mcp-tunnel": "pnpm --filter @workspace/mcp-tunnel build:tunnel",
    "test": "pnpm build && pnpm --filter @workspace/pi-adapter test && pnpm --filter @workspace/mcp-image-adapter test && pnpm --filter @workspace/mcp-tunnel test"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "esbuild": "0.25.12",
    "turbo": "2.10.4",
    "typescript": "6.0.3",
    "unbuild": "^3.5.0",
    "vite-plus": "0.2.4"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.10.0"
}
