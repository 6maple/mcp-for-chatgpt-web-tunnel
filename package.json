{
  "name": "mcp-for-chatgpt-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check",
    "stub": "turbo run stub",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "vp lint --type-aware",
    "lint:fix": "vp lint --fix --type-aware",
    "quality": "vp check",
    "ci": "vp check && vp run check && vp run build",
    "setup:hooks": "vp config --no-agent",
    "postinstall": "turbo run stub && pnpm setup:hooks",
    "start-mcp-server": "pnpm --filter @workspace/mcp-server start",
    "start-tunnel": "node ./scripts/tunnel-client/start-cli.js",
    "build-tunnel": "node ./scripts/tunnel-client/build.js"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "esbuild": "0.25.12",
    "turbo": "2.10.4",
    "typescript": "6.0.3",
    "unbuild": "^3.5.0",
    "vite-plus": "0.2.4"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.10.0"
}
